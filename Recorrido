RunService.Heartbeat:Connect(function(deltaTime)
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp or humanoid.Health <= 0 then return end

    local peligroActual, distPeligro = getPeligroMasCercano()
    local enZonaSegura = isEnZonaSegura(hrp.Position)
    local velocidadAcercamiento = 0

    if peligroActual then
        if infoLabelPeligro then
            infoLabelPeligro.Text = string.format("Peligro a: %.1f studs", distPeligro)
        end

        local lastDist = histPeligrosDist[peligroActual] or distPeligro
        velocidadAcercamiento = (lastDist - distPeligro) / deltaTime
        histPeligrosDist[peligroActual] = distPeligro
    else
        if infoLabelPeligro then
            infoLabelPeligro.Text = "Peligro a: Ninguno"
        end
    end

    local bloqueadoPorPeligro = false

    -- Zona Segura: esperar 0.3s a que pase el peligro
    if enZonaSegura and peligroActual and distPeligro <= 50 then
        if not haEsperadoPaso then
            bloqueadoPorPeligro = true
            if velocidadAcercamiento < -0.1 then
                tiempoPausaSegura = 0.3
                haEsperadoPaso = true
            end
        end
    end

    if not peligroActual or distPeligro > 50 then
        haEsperadoPaso = false
    end

    if tiempoPausaSegura > 0 then
        tiempoPausaSegura = tiempoPausaSegura - deltaTime
        bloqueadoPorPeligro = true
    end

    -- Detección de peligro por enfrente
    local vienePorFrente = false
    if peligroActual and not enZonaSegura then
        local dirPeligro = (peligroActual.Position - hrp.Position).Unit
        local lookVector = hrp.CFrame.LookVector
        if lookVector:Dot(dirPeligro) > 0.5 then
            vienePorFrente = true
        end
    end

    -- LÓGICA DE EVASIÓN: RETROCEDER AL CHECKPOINT ANTERIOR
    if not enZonaSegura and peligroActual and distPeligro <= 100 and vienePorFrente and velocidadAcercamiento > 0.5 then
        if not estado.evadiendo then
            estado.evadiendo = true
            -- Retroceder al checkpoint anterior inmediatamente
            estado.indiceActual = math.max(1, estado.indiceActual - 1)
            tiempoAtascadoEvadiendo = 0
            ultimaDistanciaEvasion = math.huge
        else
            -- Verificamos si se quedó atascado intentando llegar al checkpoint de retroceso
            local nodoActualPos = getVectorFromJson(Datos.Recorrido[estado.indiceActual])
            local distAlNodo = (hrp.Position - nodoActualPos).Magnitude
            
            if math.abs(ultimaDistanciaEvasion - distAlNodo) < 0.5 then
                tiempoAtascadoEvadiendo = tiempoAtascadoEvadiendo + deltaTime
                -- Si lleva más de 1 segundo sin poder avanzar hacia ese checkpoint, retroceder al anterior de ese
                if tiempoAtascadoEvadiendo >= 1.0 then
                    estado.indiceActual = math.max(1, estado.indiceActual - 1)
                    tiempoAtascadoEvadiendo = 0
                end
            else
                tiempoAtascadoEvadiendo = 0
            end
            ultimaDistanciaEvasion = distAlNodo
        end

        humanoid.AutoRotate = true
        humanoid.WalkSpeed = math.clamp(estado.velocidadBase + 40, 16, 150)
    else
        estado.evadiendo = false
        tiempoAtascadoEvadiendo = 0
    end

    if not estado.evadiendo then
        humanoid.WalkSpeed = estado.velocidadBase
    end

    -- MOVIMIENTO PRINCIPAL O DE RETROCESO
    if bloqueadoPorPeligro then
        humanoid:MoveTo(hrp.Position)
    elseif estado.corriendo and not estado.pausado then
        local totalNodos = #Datos.Recorrido
        if estado.indiceActual <= totalNodos then
            local nodoActual = getVectorFromJson(Datos.Recorrido[estado.indiceActual])
            
            humanoid.AutoRotate = true
            humanoid:MoveTo(nodoActual)

            -- Si estamos evadiendo, podemos requerir menos distancia para dar por superado el checkpoint trasero o avanzar al siguiente si el peligro pasó
            local rangoLlegada = estado.evadiendo and 6 or 4
            if (hrp.Position - Vector3.new(nodoActual.X, hrp.Position.Y, nodoActual.Z)).Magnitude < rangoLlegada then
                if not estado.evadiendo then
                    estado.indiceActual = estado.indiceActual + 1
                end
            end
        else
            if estado.indefinido then
                estado.indiceActual = 1
            else
                estado.corriendo = false
            end
        end
    end
end)
