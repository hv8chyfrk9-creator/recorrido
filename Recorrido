local function getVectorFromJson(nodo)
    return Vector3.new(nodo.X, nodo.Y, nodo.Z)
end

local function isEnZonaSegura(pos)
    for _, zona in ipairs(Datos.ZonasSeguras) do
        local zonaPos = getVectorFromJson(zona)
        if (zonaPos - pos).Magnitude <= 0.5 then
            return true
        end
    end
    return false
end

